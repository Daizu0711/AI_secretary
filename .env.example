# ---- ManageBac ----
MB_BASE_URL=https://nihs.managebac.com
MB_EMAIL=you@example.com
MB_PASSWORD=your-managebac-password
# ManageBac クライアントの置き場所(省略時 ~/Documents/managebac auto)
# MB_DIR=/Users/sota/Documents/managebac auto

# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# アプリと同じアカウント
SB_EMAIL=you@example.com
SB_PASSWORD=your-supabase-password

# サービスロールで動かす場合(任意)。設定すると SB_EMAIL/SB_PASSWORD は不要
# SUPABASE_SERVICE_ROLE_KEY=
# SB_USER_ID=
